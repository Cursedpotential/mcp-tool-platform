# PostgreSQL + PGVector + PostGIS Configuration
# Copy this to .env and fill in your values

# Database Configuration
POSTGRES_DB=salem
POSTGRES_USER=salem_user
POSTGRES_PASSWORD=your_secure_password_here

# PGVector Settings
# Vector embedding dimensions (OpenAI text-embedding-ada-002)
PGVECTOR_VECTOR_SIZE=1536

# PostGIS Settings (for geospatial queries if needed)
POSTGIS_ENABLED=true

# Database Connection String (for drizzle.config.ts)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Backup Settings (optional)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
