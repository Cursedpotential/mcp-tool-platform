# =============================================================================
# Salem Forensic Trinity - VPS3 (salem-platform) Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before deployment.
# WARNING: DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# =============================================================================

# -----------------------------------------------------------------------------
# General Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
DOMAIN=mitechconsult.com
TZ=America/New_York

# -----------------------------------------------------------------------------
# Database (Postgres on VPS1 - salem-nexus)
# -----------------------------------------------------------------------------
# Internal IP: 10.10.0.2
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://postgres:YOUR_STRONG_PASSWORD@10.10.0.2:5432/salem?sslmode=disable

# -----------------------------------------------------------------------------
# Cache / Queue (Dragonfly/Redis on VPS2 - salem-forge)
# -----------------------------------------------------------------------------
# Internal IP: 10.10.0.3
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL=redis://:YOUR_DRAGONFLY_PASSWORD@10.10.0.3:6379

# -----------------------------------------------------------------------------
# LLM Gateway (LiteLLM on VPS2 - salem-forge)
# -----------------------------------------------------------------------------
# Internal IP: 10.10.0.3
LITELLM_URL=http://10.10.0.3:4000
# Must match the master key set on VPS2
LITELLM_MASTER_KEY=YOUR_LITELLM_MASTER_KEY

# -----------------------------------------------------------------------------
# Vector Database (ChromaDB on VPS2 - salem-forge)
# -----------------------------------------------------------------------------
# Internal IP: 10.10.0.3
CHROMA_URL=http://10.10.0.3:8000
# Must match the API key set on VPS2
CHROMA_API_KEY=YOUR_CHROMA_API_KEY

# -----------------------------------------------------------------------------
# Graph Database (Neo4j Aura - External)
# -----------------------------------------------------------------------------
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# -----------------------------------------------------------------------------
# Authentication & Storage (Supabase - External)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# -----------------------------------------------------------------------------
# Security & Encryption
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
JWT_SECRET=

# -----------------------------------------------------------------------------
# Other Services
# -----------------------------------------------------------------------------
# Optional: LangSmith or other tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
