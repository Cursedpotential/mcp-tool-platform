# =============================================================================
# Salem Forensic Trinity - VPS3 (salem-platform) Environment Variables
# =============================================================================
# Copy this file to .env and fill in all required values
# Required fields marked with (REQUIRED)
# =============================================================================

# =============================================================================
# DOMAIN & HOSTING
# =============================================================================
DOMAIN=mitechconsult.com
TZ=America/New_York

# =============================================================================
# MYSQL CONFIGURATION (Local on VPS3)
# =============================================================================
MYSQL_ROOT_PASSWORD=                  # (REQUIRED) Strong root password
MYSQL_DATABASE=salem_app
MYSQL_USER=salem_user
MYSQL_PASSWORD=                       # (REQUIRED) App user password

# =============================================================================
# VPS1 POSTGRES CONNECTION (via Private Network 10.10.0.2)
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                    # (REQUIRED) Must match VPS1 Postgres password
POSTGRES_DB=salem

# =============================================================================
# VPS2 CHROMA & LITELLM CONNECTION (via Private Network 10.10.0.3)
# =============================================================================
CHROMA_API_KEY=                       # (REQUIRED) Must match VPS2 Chroma API Key
LITELLM_MASTER_KEY=                   # (REQUIRED) Must match VPS2 LiteLLM Master Key

# =============================================================================
# VPS1 DIRECTUS CONNECTION (via Private Network 10.10.0.2)
# =============================================================================
DIRECTUS_TOKEN=                       # (REQUIRED) Admin token from Directus on VPS1

# =============================================================================
# NEO4J AURA (Cloud)
# =============================================================================
NEO4J_URI=                            # (REQUIRED) e.g., bolt+s://...
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=                       # (REQUIRED)

# =============================================================================
# AUTH & SECURITY
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=                      # (REQUIRED)
JWT_SECRET=                           # (REQUIRED)

# =============================================================================
# EXTERNAL AI APIs
# =============================================================================
OPENAI_API_KEY=                       # (Optional)
ANTHROPIC_API_KEY=                    # (Optional)

# =============================================================================
# GENERATION COMMANDS
# =============================================================================
# NextAuth Secret:
#   openssl rand -base64 32
#
# JWT Secret:
#   openssl rand -hex 32
#
# MySQL Passwords:
#   openssl rand -hex 16
# =============================================================================
