# =============================================================================
# Salem Forensic Trinity - VPS2 (salem-forge) Environment Variables
# =============================================================================
# Copy this file to .env and fill in all required values
# Required fields marked with (REQUIRED)
# Optional fields have defaults or can be left empty
# =============================================================================

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
DOMAIN=mitechconsult.com

# Timezone
TZ=America/New_York

# =============================================================================
# DATABASE CONNECTION (VPS1 Postgres via Private Network)
# =============================================================================
# CRITICAL: Uses Hetzner private network IP (10.10.0.2) NOT public IP
# This provides free bandwidth, better security, lower latency
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                    # (REQUIRED) VPS1 Postgres password
POSTGRES_DB=salem

# =============================================================================
# LITELLM CONFIGURATION
# =============================================================================
# Master API Key - Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=                   # (REQUIRED) Master API key for LiteLLM admin

# LiteLLM Config File Path (local path, will be mounted into container)
LITELLM_CONFIG_PATH=./litellm-config.yaml

# =============================================================================
# CHROMADB CONFIGURATION
# =============================================================================
# API Key - Generate with: openssl rand -hex 32
CHROMA_API_KEY=                       # (REQUIRED) ChromaDB authentication token

# =============================================================================
# DRAGONFLY CONFIGURATION
# =============================================================================
# Password for Redis protocol access (optional, leave empty for no password)
DRAGONFLY_PASSWORD=

# =============================================================================
# BROWSERLESS CONFIGURATION
# =============================================================================
# Token - Generate with: openssl rand -hex 16
BROWSERLESS_TOKEN=                    # (REQUIRED) Browserless API token

# =============================================================================
# DOCKER HUB (Optional - for Kasm private images)
# =============================================================================
DOCKER_HUB_USERNAME=
DOCKER_HUB_PASSWORD=

# =============================================================================
# GENERATION COMMANDS
# =============================================================================
# Run these commands to generate secure random keys:
#
# LiteLLM Master Key (64 chars):
#   openssl rand -hex 32
#
# ChromaDB API Key (64 chars):
#   openssl rand -hex 32
#
# Browserless Token (32 chars):
#   openssl rand -hex 16
#
# Dragonfly Password (optional, 32 chars):
#   openssl rand -hex 16
#
# =============================================================================

# =============================================================================
# EXAMPLE .env FILE (Fill in the blank values)
